########################################
# MQTT BROKER CONNECTION
########################################
# Placeholder values -- point these at your ThingsBoard MQTT broker (or a local
# test broker such as Mosquitto / aedes) before running the simulator.
MQTT_HOST=localhost
MQTT_PORT=1883
# One of: mqtt | mqtts | ws | wss
MQTT_PROTOCOL=mqtt
# Optional broker-level username/password. Leave blank if every device
# authenticates individually via devices.json (recommended, matches production).
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=v1/devices/me/telemetry
# 0 = at most once, 1 = at least once, 2 = exactly once
MQTT_QOS=1
MQTT_RETAIN=false
# Comma-separated list of additional topics to subscribe to, beyond the
# standard ThingsBoard RPC/attribute topics. Leave blank for none.
MQTT_EXTRA_SUBSCRIBE_TOPICS=

########################################
# DEVICE FLEET
########################################
# Max number of devices loaded from devices.json (0 or blank = load all)
DEVICE_LIMIT=2
# One of: sequential | random | shuffle | round-robin | random-batch
DEVICE_SELECTION_MODE=sequential
# Number of devices started together per ramp-up batch
DEVICE_BATCH_SIZE=1
ENABLE_RANDOMIZATION=true

########################################
# SIMULATION / PUBLISHING
########################################
PUBLISH_INTERVAL_MS=5000
# One of: template | random | mixed
PAYLOAD_MODE=template
# One of: constant | ramp-up | ramp-down | spike | burst | random-interval |
#         scheduled | peak-hour | night | chaos
SIMULATION_MODE=constant
MAX_MESSAGES_PER_SECOND=200
START_DELAY=0
RAMP_UP_TIME=0
RAMP_DOWN_TIME=0
HEARTBEAT_INTERVAL=30000

# 'spike' mode: every SPIKE_INTERVAL_MS, publish SPIKE_FACTOR times faster for SPIKE_DURATION_MS.
SPIKE_INTERVAL_MS=30000
SPIKE_DURATION_MS=3000
SPIKE_FACTOR=5
# 'burst' mode: fire BURST_SIZE messages back-to-back, then go idle for BURST_QUIET_MS.
BURST_SIZE=10
BURST_QUIET_MS=15000
# 'peak-hour' / 'scheduled' modes: faster publishing within [PEAK_HOUR_START, PEAK_HOUR_END).
PEAK_HOUR_START=9
PEAK_HOUR_END=17
PEAK_HOUR_RATE_MULTIPLIER=3
# 'night' / 'scheduled' modes: faster publishing during the 18:00-06:00 window.
NIGHT_RATE_MULTIPLIER=2
# 'chaos' mode: interval randomized each tick between base*MIN and base*MAX.
CHAOS_MIN_FACTOR=0.1
CHAOS_MAX_FACTOR=5

########################################
# FEATURE TOGGLES
########################################
ENABLE_RECONNECT=true
ENABLE_RPC=true
ENABLE_ATTRIBUTE_UPDATES=true
ENABLE_LOGGING=true
ENABLE_WEBSOCKET=true
ENABLE_UI=true
LATENCY_TRACKING=true

########################################
# MQTT CLIENT BEHAVIOR
########################################
COMMAND_TIMEOUT=10000
KEEPALIVE=60
CLIENT_CLEAN_SESSION=true
AUTO_RECONNECT=true
RECONNECT_PERIOD=2000

########################################
# WORKER / CONCURRENCY
########################################
WORKER_COUNT=4
# false (default): shard devices across worker_threads (one process, real OS-thread
# parallelism). true: shard across forked child_processes instead -- OS-level crash
# isolation and independent process supervision, still single-host (no Redis/multi-host).
CLUSTER_MODE=false

########################################
# SERVERS
########################################
SOCKET_PORT=4001
API_PORT=4000

########################################
# LOGGING
########################################
# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

########################################
# METRICS / EXPORT
########################################
METRICS_INTERVAL=2000
CSV_EXPORT=true
JSON_EXPORT=true
